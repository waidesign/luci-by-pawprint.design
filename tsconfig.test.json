{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@luci/format": ["./packages/format/src/index.ts"],
      "@luci/format/capture": ["./packages/format/src/capture/index.ts"],
      "@luci/format/feedback": ["./packages/format/src/feedback/index.ts"],
      "@luci/brain": ["./packages/brain/src/index.ts"],
      "@luci/skills": ["./packages/skills/src/index.ts"],
      "@luci/capture": ["./packages/capture/src/index.ts"],
      "@luci/feedback": ["./packages/feedback/src/index.ts"],
      "@luci/toolbar": ["./packages/toolbar/src/index.ts"]
    }
  },
  "include": ["packages/*/test/**/*.ts", "vitest.config.ts", "test-setup.ts", "test-global-setup.ts"]
}
