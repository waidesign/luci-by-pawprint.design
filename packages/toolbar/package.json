{
  "name": "@luci-dev/toolbar",
  "version": "0.5.5",
  "description": "The dev toolbar: feedback and capture in your own app, saved into the project through luci serve.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./script": {
      "default": "./dist/luci-toolbar.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@luci-dev/capture": "workspace:*",
    "@luci-dev/feedback": "workspace:*",
    "@luci-dev/format": "workspace:*",
    "@luci-dev/ui": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/waidesign/luci-by-pawprint.design.git",
    "directory": "packages/toolbar"
  },
  "homepage": "https://github.com/waidesign/luci-by-pawprint.design#readme",
  "bugs": {
    "url": "https://github.com/waidesign/luci-by-pawprint.design/issues"
  },
  "author": "Pawprint Design <lucas@pawprint.design>"
}
