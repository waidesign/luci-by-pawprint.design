{
  "name": "@luci/toolbar",
  "version": "0.0.0",
  "private": true,
  "description": "The dev toolbar: feedback and capture in your own app, saved into the project through luci serve.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./script": {
      "default": "./dist/luci-toolbar.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@luci/capture": "workspace:*",
    "@luci/feedback": "workspace:*",
    "@luci/format": "workspace:*",
    "@luci/ui": "workspace:*"
  }
}
