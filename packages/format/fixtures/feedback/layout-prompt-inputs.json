    "viewport": { "width": 1920, "height": 1080 },
    "note": "Make the plans feel more spacious, and put Pro first",
    "elements": [
      {
        "element": "div", "selector": "main > section > div:nth-of-type(2)", "text": "Pro $12 per month Start free trial",
        "components": ["App", "Pricing", "PlanCard"], "source": { "file": "src/components/PlanCard.jsx", "line": 3, "column": 5 },
        "changes": [
          { "op": "move", "position": "before", "sibling": { "selector": "main > section > div:nth-of-type(1)", "element": "div" }, "from": 2, "to": 1, "of": 2 },
          { "op": "set", "property": "max-width", "from": "none", "to": "480px" },
          { "op": "set", "property": "padding-top", "from": "16px", "to": "24px", "token": "--space-6" },
          { "op": "set", "property": "padding-bottom", "from": "16px", "to": "24px", "token": "--space-6" }
        ]
      },
      {
        "element": "section (region)", "selector": "main > section",
        "components": ["App", "Pricing"], "source": { "file": "src/pages/Pricing.jsx", "line": 5 },
        "changes": [
          { "op": "set", "property": "display", "from": "block", "to": "grid" },
          { "op": "set", "property": "grid-template-columns", "from": "none", "to": "repeat(2, minmax(0, 1fr))" },
          { "op": "set", "property": "column-gap", "from": "normal", "to": "24px", "token": "--space-6" }
        ]
      }
    ]
  }
