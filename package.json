{
  "name": "luci-monorepo",
  "version": "0.5.7",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-toolbar.mjs",
    "typecheck": "tsc -b && node scripts/build-toolbar.mjs && tsc -p tsconfig.test.json && pnpm --filter @luci-dev/extension exec wxt prepare && tsc -p packages/extension/tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "test:extension": "node scripts/test-extension.mjs",
    "test:multipage": "node scripts/eval-multipage.mjs",
    "brand:sync": "node scripts/brand-sync.mjs"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "@vue/compiler-sfc": "3.5.45",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svelte": "5.57.3",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "vue": "3.5.45"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/waidesign/luci-by-pawprint.design.git"
  },
  "homepage": "https://github.com/waidesign/luci-by-pawprint.design#readme",
  "bugs": {
    "url": "https://github.com/waidesign/luci-by-pawprint.design/issues"
  },
  "author": "Pawprint Design <lucas@pawprint.design>"
}
